# Backend Docker environment
# Use Docker services for database connections

# Database - connect to Docker services
DATABASE_URL=postgresql://postgres:postgres@pg:5432/autoria_db

# Django settings
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=true
DJANGO_DEBUG=true
SECRET_KEY=django-insecure-educational-key-2024-autoria-clone-fullstack-project-demo

# Docker environment
IS_DOCKER=true

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# CORS settings for Docker
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email settings (optional)
EMAIL_HOST=mailhog
EMAIL_PORT=1025

# Media files
MEDIA_URL=/media/
STATIC_URL=/static/

# Security settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
